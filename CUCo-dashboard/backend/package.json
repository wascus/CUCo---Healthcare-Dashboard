    "@fastify/jwt": "^10.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@prisma/client": "^6.19.0",
    "@sinclair/typebox": "^0.34.41",
    "bcryptjs": "3.0.2",
    "dotenv": "17.2.2",
    "fastify": "5.6.1",
    "jsonwebtoken": "9.0.2",
    "pg": "8.16.3",
    "react-hook-form": "^7.63.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.10",
