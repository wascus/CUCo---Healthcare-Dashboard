{
  "name": "cuco-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CUCo API server (Fastify + Prisma + PostgreSQL)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
