    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/shopItemSeed"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fastify/cookie": "10.0.0",
